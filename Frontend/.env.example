# Backend origin (the BFF appends /v1/...). Server-side only is enough; the
# browser never calls it directly. API_URL takes precedence if both are set.
NEXT_PUBLIC_API_URL=http://localhost:3000
# API_URL=http://localhost:3000

# Run fully against the in-process MSW mock backend (no backend needed).
NEXT_PUBLIC_API_MOCKING=enabled

# Minutes of inactivity before the app locks (PIN to unlock). 0 disables.
NEXT_PUBLIC_AUTOLOCK_MINUTES=5

# Only for plain-http testing on a LAN IP (Secure cookies need https or localhost).
# COOKIE_SECURE=false

# Mock tuning (mock mode only)
# MOCK_LATENCY_MS=120
# MOCK_FUNDING_DELAY_MS=4000
# MOCK_QUOTE_TTL_MS=30000
# MOCK_ACCESS_TTL_S=900
