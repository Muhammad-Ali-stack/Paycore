NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database: Supabase PostgreSQL (DB only; the NestJS API owns auth) ─────────────
# Runtime: Supavisor TRANSACTION pooler (port 6543). pgbouncer=true is required
# (disables prepared statements). Keep connection_limit modest; the free tier caps pooler clients.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20
# Migrations: direct connection (db.YOUR_PROJECT_REF.supabase.co:5432, IPv6 only on free tier)
# or the SESSION pooler (IPv4) on port 5432, as below.
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Ledger transaction isolation: RepeatableRead (default) or Serializable
DB_TX_ISOLATION=RepeatableRead
DB_TX_MAX_RETRIES=20

# ── Redis: hosted Redis Cloud over TLS, eviction policy MUST be noeviction ─────────
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@your-redis-host.cloud.redislabs.com:12345
# Conservative BullMQ polling (used by queue workers from the next phase)
BULLMQ_DRAIN_DELAY_SECONDS=30
BULLMQ_STALLED_INTERVAL_MS=60000
BULLMQ_WORKER_CONCURRENCY=2

# JWT (use long random secrets; min 32 chars)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Auth hardening
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
PIN_MAX_FAILED_ATTEMPTS=3
PIN_LOCKOUT_SECONDS=1800
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Echo OTP codes in API responses (never allowed when NODE_ENV=production)
OTP_DEV_ECHO=true

# Rate limiting (global default per tracker)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_SECONDS=60

# FX
FX_RATE_CACHE_TTL_SECONDS=60
FX_QUOTE_TTL_SECONDS=30
FX_SPREAD_BPS=50
FX_FEE_BPS=25

# Fees
TRANSFER_FEE_BPS=0
WITHDRAWAL_FEE_BPS=10

# Bootstrap admin (used by prisma seed)
ADMIN_PHONE=+923000000000
ADMIN_PASSWORD=ChangeMe!Admin123

# ── Phase 2: queues, outbox and background jobs ────────────────────────────────────
# bullmq: domain events and repeatable jobs run in the worker process (npm run start:worker).
# inline: processed inside the API process without Redis workers (tests / local dev). Production requires bullmq.
QUEUE_DRIVER=bullmq
# inline driver only: run repeatable jobs on in-process timers (ignored under NODE_ENV=test)
INLINE_SCHEDULER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=12
# payment timeouts, request expiry, quote/QR expiry
MAINTENANCE_INTERVAL_MS=60000
# UTC cron patterns
SETTLEMENT_CRON=0 2 * * *
RECONCILIATION_CRON=30 3 * * *

# ── Payments / transfers ──
TRANSFER_QUOTE_TTL_SECONDS=60
PAYMENT_PROCESSING_TIMEOUT_SECONDS=120
PAYMENT_REQUEST_DEFAULT_TTL_HOURS=72
LOOKUP_THROTTLE_LIMIT=30

# ── QR (HMAC-SHA256; required, >= 32 chars, in production) ──
QR_SIGNING_SECRET=change-me-qr-signing-secret-at-least-32-characters
QR_SIGNING_KEY_ID=k1
# verify-only keys during rotation: kid:secret,kid:secret
QR_SIGNING_PREVIOUS_KEYS=
QR_PREVIEW_TTL_SECONDS=120
QR_P2P_TTL_SECONDS=900

# ── Funding / bank adapter ──
BANK_ADAPTER=simulated
# shared with the bank for X-PayCore-Signature (required, >= 32 chars, in production)
BANK_WEBHOOK_SECRET=change-me-bank-webhook-secret-at-least-32-characters
BANK_WEBHOOK_TOLERANCE_SECONDS=300
# POST /v1/dev/bank/simulate (config validation refuses true in production)
BANK_SIM_ENABLED=true
# where the simulator delivers webhooks over HTTP (e.g. from the worker to the API); unset = in-process delivery
# BANK_SIM_WEBHOOK_URL=http://localhost:3000/v1/webhooks/bank
TOPUP_PENDING_TIMEOUT_HOURS=24
WITHDRAWAL_PENDING_TIMEOUT_HOURS=72
SETTLEMENT_PAYOUT_TIMEOUT_HOURS=72

# ── Merchants ──
MERCHANT_DEFAULT_MDR_BPS=150
MERCHANT_DEFAULT_SETTLEMENT_DELAY_DAYS=1
